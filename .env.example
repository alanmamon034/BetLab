# --- Copy this file to .env.local for local dev ---
# --- On Vercel, add these under Project Settings > Environment Variables ---

# Provided automatically when you attach Vercel Postgres to the project:
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# POSTGRES_URL_NON_POOLING=...

# Server-side secret used to sign session tokens (fake value, lab only)
JWT_SECRET=lab_jwt_super_secret_change_me_0001

# Mock "payments" provider key (fake value, lab only)
PAYMENTS_API_KEY=sk_test_FAKE_51ABCXYZ000000

# --- INTENTIONAL LAB BUG ---
# This one is prefixed NEXT_PUBLIC_, which means Next.js will bundle it
# into the client-side JavaScript and ship it to every visitor's browser.
# This is a classic real-world leak pattern. Your job later: find it in
# the deployed site's JS bundle via view-source, without ever seeing this file.
NEXT_PUBLIC_ODDS_API_KEY=oak_live_FAKE_9f8e7d6c5b4a3210
